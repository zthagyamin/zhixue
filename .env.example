# Optional account-study transport. Keep disabled until the complete integration
# and paired acceptance are verified. Hosted values are configured through Sites.
ACCOUNT_STUDY_ENABLED=false
ACCOUNT_STUDY_AI_ENABLED=false
ACCOUNT_STUDY_AI_MODEL=
# Maintainer-owned JSON array of additional public HTTPS origins (no path/port).
# Never accept this setting from an account.
ACCOUNT_STUDY_AI_ALLOWED_ORIGINS=[]
# 32 random bytes encoded with base64url. It encrypts each account's separately
# supplied cloud DeepSeek key; Companion/local keys are never copied.
ACCOUNT_STUDY_AI_ENCRYPTION_KEY=
