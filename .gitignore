# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# framework and build output
/.next/
/.vinext/
/out/
/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo

# local development artifacts
/scratch/
/.stage2-material/
/.superpowers/
/public/vendor/pyodide-*/
/backups/
/errors.txt
/errors2.txt
/public/test_pyodide.html

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!**/.env.example

# Companion local state
companion/__pycache__/
companion/.venv/
companion/runtime/
companion/data/runtime-instance.json
companion/data/learning-workspace/
companion/data/setup-backups/
companion/config.local.json
companion/data/*.db
companion/data/*.db-shm
companion/data/*.db-wal
**/__pycache__/

# hosting providers
.vercel

# Reproducible release assets are acquired separately, never committed
/public/downloads/*.exe
/public/downloads/*.zip
/companion/runtime-windows-x64.zip
# Local sources, review evidence, and operator configuration
.openai/hosting.local.json
.gitleaks-report*.json
*.log
/docs/verification/
/companion/config.local.json

