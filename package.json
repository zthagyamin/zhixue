{
  "name": "zhixue-study-loop",
  "version": "1.41.1",
  "private": true,
  "description": "由个人资料驱动的 IELTS、Python 与差分复习学习系统。",
  "homepage": "https://zhixue-daily.zthagyamin.chatgpt.site",
  "repository": "https://github.com/zthagyamin/zhixue",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-browser-assets.mjs",
    "prebuild": "npm run assets:companion && node scripts/prepare-browser-assets.mjs",
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "postbuild": "node scripts/externalize-companion-downloads.mjs",
    "start": "node scripts/run-vinext.mjs start",
    "test": "npm run architecture:check && npm run release:check && npm run lint && npm run typecheck && npm run build && npm run test:node",
    "architecture:check": "node scripts/architecture.mjs",
    "test:python": "node scripts/run-python-suite.mjs",
    "test:node": "node --experimental-strip-types --test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "package:companion": "pwsh.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-companion.ps1",
    "release:check": "node --experimental-strip-types scripts/check-release-notes.mjs",
    "assets:companion": "node scripts/prepare-companion-assets.mjs",
    "pretest": "npm run assets:companion",
    "open-source:check": "node scripts/check-open-source.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.11",
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.4",
    "pdfjs-dist": "6.3.289",
    "prismjs": "^1.30.0",
    "pyodide": "314.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-simple-code-editor": "^0.14.1",
    "ts-fsrs": "5.4.1"
  },
  "overrides": {
    "ws": "8.21.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/workers-types": "5.20260915.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "type": "module",
  "license": "MIT"
}
